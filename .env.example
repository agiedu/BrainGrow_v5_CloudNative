# Backend / Render
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://YOUR-CLOUDFLARE-PAGES-DOMAIN.pages.dev
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Email - leave MAIL_USERNAME blank for local development; code is printed to backend logs
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Frontend
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
